@{
    Layout = "_LayoutPaciente";
    ViewData["Title"] = "Centro de Apoyo";
}

<div class="container-fluid p-0">
    <!-- Encabezado de Bienvenida -->
    <div class="mb-4">
        <h1 class="fw-bold fs-2 text-dark mb-1">Centro de Apoyo y Acompañamiento</h1>
        <p class="text-secondary fs-6">
            Estamos aquí para escucharte y ayudarte. Puedes comunicarte en un entorno seguro y confidencial.
        </p>
    </div>

    <!-- Botón Destacado de Acción Rápida (Atención Inmediata) -->
    <div class="p-4 mb-4 rounded-4" style="background-color: #d8f3e5; border: 1px solid #b7e4c7;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1" style="color: #1b4d3e;">¿Necesitas hablar con alguien ahora mismo?</h4>
                <p class="m-0 text-muted" style="color: #2d6a4f !important;">Nuestros profesionales están disponibles para atenderte por chat en tiempo real.</p>
            </div>
            <a asp-controller="Paciente" asp-action="Chat" class="btn text-white font-weight-bold px-4 py-2 rounded-3" style="background-color: #1b4d3e;">
                Iniciar Chat Seguro
            </a>
        </div>
    </div>

    <!-- Bloques de Opciones Principales -->
    <div class="row g-4">
        <!-- Opción 1: Chat Seguro -->
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
                <div class="fs-3 mb-2">💬</div>
                <h5 class="fw-bold">Chat Seguro</h5>
                <p class="text-muted small">Conéctate de forma anónima o registrada con un profesional de la salud mental.</p>
                <a asp-controller="Paciente" asp-action="Chat" class="text-decoration-none fw-bold small" style="color: #1b4d3e;">Ir al chat &rarr;</a>
            </div>
        </div>

        <!-- Opción 2: Líneas de Ayuda -->
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
                <div class="fs-3 mb-2">📞</div>
                <h5 class="fw-bold">Líneas de Ayuda</h5>
                <p class="text-muted small">Directorio telefónico de emergencia y atención en crisis disponible 24/7 en Costa Rica.</p>
                <a asp-controller="Paciente" asp-action="LineasAyuda" class="text-decoration-none fw-bold small" style="color: #1b4d3e;">Ver números &rarr;</a>
            </div>
        </div>

        <!-- Opción 3: Registro de Usuario / Perfil -->
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
                <div class="fs-3 mb-2">👤</div>
                <h5 class="fw-bold">Registro / Mi Cuenta</h5>
                <p class="text-muted small">Crea tu cuenta para dar seguimiento personal a tus conversaciones e historial.</p>
                <a asp-controller="Paciente" asp-action="Perfil" class="text-decoration-none fw-bold small" style="color: #1b4d3e;">Registrarme &rarr;</a>
            </div>
        </div>
    </div>
</div>