@model AquiEstoy.Web.Models.LoginViewModel
@{
    Layout = null; // No utiliza layout lateral
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Aquí Estoy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f3f5f6;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            width: 100%;
            max-width: 400px;
            padding: 2.5rem;
        }

        .btn-mint {
            background-color: #2d6a4f;
            color: #ffffff;
            border: none;
            font-weight: 600;
        }

            .btn-mint:hover {
                background-color: #1b4d3e;
                color: #ffffff;
            }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="text-center mb-4">
            <h3 class="fw-bold" style="color: #1b4d3e;">Aquí Estoy</h3>
            <p class="text-muted small">Ingresa tus credenciales para acceder</p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold">Correo Electrónico</label>
                <input asp-for="Email" class="form-control rounded-3" placeholder="ejemplo@correo.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label small fw-semibold">Contraseña</label>
                <input asp-for="Password" class="form-control rounded-3" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-mint w-100 py-2 rounded-3 mb-3">Iniciar Sesión</button>
        </form>

        <div class="p-3 rounded-3 mt-3 text-start small" style="background-color: #f8faf9; border: 1px solid #e2e8f0;">
            <span class="fw-bold d-block text-muted mb-1">Pruebas rápidas:</span>
            <div>👨‍💼 <b>Admin:</b> admin@aquiestoy.com / admin123</div>
            <div>👤 <b>Paciente:</b> paciente@aquiestoy.com / user123</div>
        </div>
    </div>

</body>
</html>