@model IEnumerable<AquiEstoy.Domain.Entities.Mensaje>

@{
    ViewData["Title"] = "Consola de Atención en Crisis";

    // Obtener la identificación de la conversación desde ViewBag
    var conversacionId = ViewBag.ConversacionId ?? 1;
    var profesionalUserId = 2; // ID asignado al Profesional en la DB
}

<div class="container-fluid p-0">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <!-- ÁREA DE MENSAJES (HISTORIAL DB + TIEMPO REAL) -->
        <div class="card-body p-4" id="chatMessagesAdmin" style="height: 380px; overflow-y: auto; background-color: #fafafa;">
            <div class="text-center text-muted small my-2">-- Sesión de atención iniciada --</div>

            @if (Model != null && Model.Any())
            {
                @foreach (var msg in Model)
                {
                    // Evalúa si el mensaje fue enviado por el Profesional actual
                    var isMe = msg.RemitenteId == profesionalUserId;
                    var align = isMe ? "text-end" : "text-start";
                    var bgClass = isMe ? "bg-dark text-white" : "bg-white border text-dark";

                    <div class="@align mb-3">
                        <div class="d-inline-block p-3 rounded-4 @bgClass" style="max-width: 75%;">
                            <strong class="d-block small @(isMe ? "text-white-50" : "text-muted")">
                                @(msg.Remitente?.Nombre ?? (isMe ? "Profesional" : $"Paciente ({msg.RemitenteId})")) • @msg.FechaEnvio.ToLocalTime().ToString("HH:mm")
                            </strong>
                            <div>@msg.Contenido</div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- BARRA DE ENVÍO -->
        <div class="card-footer bg-white p-3 border-top-0">
            <div class="input-group">
                <input type="text" id="messageInputAdmin" class="form-control rounded-pill px-3" placeholder="Escribe tu respuesta al paciente..." autocomplete="off" />
                <button class="btn btn-dark rounded-pill px-4 ms-2" id="sendButtonAdmin">Enviar Respuesta</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const casoId = "@conversacionId";
        const userId = "@profesionalUserId";
        const userName = "Profesional";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        // 1. Recibir mensajes en tiempo real
        connection.on("ReceiveMessage", function (user, message, time) {
            const isMe = user === userName || user === userId;
            const align = isMe ? "text-end" : "text-start";
            const bgClass = isMe ? "bg-dark text-white" : "bg-white border text-dark";

            const msgHtml = `
                <div class="${align} mb-3">
                    <div class="d-inline-block p-3 rounded-4 ${bgClass}" style="max-width: 75%;">
                        <strong class="d-block small ${isMe ? 'text-white-50' : 'text-muted'}">${isMe ? 'Profesional' : 'Paciente'} • ${time}</strong>
                        <div>${escapeHtml(message)}</div>
                    </div>
                </div>`;

            const chatBox = document.getElementById("chatMessagesAdmin");
            if (chatBox) {
                chatBox.innerHTML += msgHtml;
                chatBox.scrollTop = chatBox.scrollHeight;
            }
        });

        // 2. Iniciar conexión y unirse al grupo de la conversación
        connection.start().then(function () {
            return connection.invoke("JoinCaseGroup", casoId);
        }).catch(err => console.error("Error SignalR:", err.toString()));

        // 3. Enviar respuesta del profesional
        function sendMessage() {
            const input = document.getElementById("messageInputAdmin");
            const message = input.value.trim();

            if (message !== "") {
                connection.invoke("SendMessage", userId, message, casoId)
                    .then(() => {
                        input.value = "";
                    })
                    .catch(err => console.error("Error al enviar:", err.toString()));
            }
        }

        document.getElementById("sendButtonAdmin").addEventListener("click", sendMessage);
        document.getElementById("messageInputAdmin").addEventListener("keypress", function (e) {
            if (e.key === 'Enter') {
                sendMessage();
                e.preventDefault();
            }
        });

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        window.addEventListener('DOMContentLoaded', () => {
            const chatBox = document.getElementById("chatMessagesAdmin");
            if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
        });
    </script>
}