@{
    ViewData["Title"] = "Consola de Atención en Crisis";
}

<div class="container-fluid p-0">
    

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4" id="chatMessagesAdmin" style="height: 380px; overflow-y: auto; background-color: #fafafa;">
            <div class="text-center text-muted small my-2">-- Sesión de atención iniciada --</div>
        </div>
        <div class="card-footer bg-white p-3 border-top-0">
            <div class="input-group">
                <input type="text" id="messageInputAdmin" class="form-control rounded-pill px-3" placeholder="Escribe tu respuesta al paciente..." />
                <button class="btn btn-dark rounded-pill px-4 ms-2" id="sendButtonAdmin">Enviar Respuesta</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const casoId = "CS-1042";
        const userName = "Profesional";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.on("ReceiveMessage", function (user, message, time) {
            const isMe = user === userName;
            const align = isMe ? "text-end" : "text-start";
            const bgClass = isMe ? "bg-dark text-white" : "bg-white border text-dark";

            const msgHtml = `
                <div class="${align} mb-3">
                    <div class="d-inline-block p-3 rounded-4 ${bgClass}" style="max-width: 75%;">
                        <strong class="d-block small ${isMe ? 'text-white-50' : 'text-muted'}">${user} • ${time}</strong>
                        <div>${message}</div>
                    </div>
                </div>`;

            document.getElementById("chatMessagesAdmin").innerHTML += msgHtml;
            document.getElementById("chatMessagesAdmin").scrollTop = document.getElementById("chatMessagesAdmin").scrollHeight;
        });

        connection.start().then(function () {
            connection.invoke("JoinCaseGroup", casoId);
        }).catch(err => console.error(err.toString()));

        function sendMessage() {
            const message = document.getElementById("messageInputAdmin").value.trim();
            if (message !== "") {
                connection.invoke("SendMessage", userName, message, casoId);
                document.getElementById("messageInputAdmin").value = "";
            }
        }

        document.getElementById("sendButtonAdmin").addEventListener("click", sendMessage);
        document.getElementById("messageInputAdmin").addEventListener("keypress", function (e) {
            if (e.key === 'Enter') sendMessage();
        });
    </script>
}